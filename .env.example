# Runtime connection used by the app (role: tictactoe_app — DML only: SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL=postgresql+asyncpg://tictactoe_app:CHANGE_ME@localhost:5432/tictactoe

# Migration connection used by Alembic (role: tictactoe_user — owner, runs DDL)
MIGRATION_DATABASE_URL=postgresql+asyncpg://tictactoe_user:CHANGE_ME@localhost:5432/tictactoe

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080
